# Required for --real runs on the default provider (never committed; personal key)
GEMINI_API_KEY=

# Optional: only needed for --provider anthropic (fresh calls; cache replay needs no key)
ANTHROPIC_API_KEY=

# SEC fair-access policy requires a descriptive User-Agent with contact email
SEC_USER_AGENT="Your Name you@example.com"

# Optional overrides. Provider: gemini (default) | anthropic
#HARNESS_PROVIDER=gemini
# Model overrides (defaults: gemini-3.6-flash for both; anthropic: claude-opus-4-8 / claude-haiku-4-5-20251001)
#HARNESS_GEN_MODEL=gemini-3.1-pro-preview
#HARNESS_JUDGE_MODEL=gemini-3.6-flash
