# Required for --real runs (never committed; personal key)
GEMINI_API_KEY=

# SEC fair-access policy requires a descriptive User-Agent with contact email
SEC_USER_AGENT="Your Name you@example.com"

# Optional overrides. Provider: gemini (the only provider)
#HARNESS_PROVIDER=gemini
# Model overrides (defaults: gemini-3.6-flash for both)
#HARNESS_GEN_MODEL=gemini-3.1-pro-preview
#HARNESS_JUDGE_MODEL=gemini-3.6-flash
